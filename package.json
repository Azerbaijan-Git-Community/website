{
  "name": "website",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && pnpm qstash:sync",
    "qstash:sync": "node --env-file-if-exists=.env scripts/qstash-schedules.ts",
    "start": "next start",
    "check": "greenly",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "bootstrap": "pnpm i && pnpm install:skills",
    "install:skills": "pnpx skills@latest experimental_install",
    "react-doctor": "react-doctor --verbose"
  },
  "dependencies": {
    "@better-auth/infra": "0.4.22",
    "@better-auth/prisma-adapter": "1.7.12",
    "@mdx-js/mdx": "3.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tailwindcss/typography": "0.5.20",
    "@upstash/qstash": "2.12.1",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "better-auth": "1.7.12",
    "dotenv": "18.0.8",
    "js-yaml": "5.5.0",
    "mcp-handler": "2.3.0",
    "motion": "14.5.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-syntax-highlighter": "16.1.2",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@electric-sql/pglite": "0.5.11",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/js-yaml": "4.0.9",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "greenly": "1.2.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "pglite-prisma-adapter": "0.7.2",
    "postcss-load-config": "6.0.1",
    "prisma": "7.9.1",
    "react-doctor": "0.9.18",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0 <13",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.15.0 <13"
  }
}
